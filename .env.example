# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Optional. A GitHub token with NO scopes (read-only public data).
# Raises the GitHub API limit from 60 to 5,000 requests an hour during builds.
# Used only at build time on the server; it is never sent to the browser.
GITHUB_TOKEN=

# Formspree form ID: the part after /f/ in your form's endpoint,
# e.g. https://formspree.io/f/xyzabcde  ->  xyzabcde
# Not a secret (it's visible in the page), but kept here so it isn't hard-coded.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# The live site's full address, with no trailing slash.
# Used for canonical links, social previews, the sitemap and robots.txt.
# Defaults to https://malachy-ugwu.vercel.app if left empty.
NEXT_PUBLIC_SITE_URL=
